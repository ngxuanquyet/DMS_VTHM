{
  "_doc": "Bảng ca CHUNG của bộ đánh giá điều kiện (#23977): server RuleEvaluator (common/tests/Unit/RuleEvaluatorListFieldTest.php) và SPA evalRule (dynamicRule.cases.test.ts) cùng đọc file này — sửa luật ở một phía thì phía kia đỏ. lists = mã ô DANH SÁCH (chọn nhiều).",
  "cases": [
    { "name": "ô danh sách giữ giá trị cũ một chuỗi: contains so phần tử, không so chuỗi con", "rule": { "field": "x", "op": "contains", "value": "12" }, "vars": { "x": "123" }, "lists": ["x"], "expect": false },
    { "name": "ô danh sách giữ giá trị cũ một chuỗi: contains đúng phần tử", "rule": { "field": "x", "op": "contains", "value": "123" }, "vars": { "x": "123" }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách mảng: contains không so chuỗi con của phần tử", "rule": { "field": "x", "op": "contains", "value": "12" }, "vars": { "x": ["123", "45"] }, "lists": ["x"], "expect": false },
    { "name": "ô danh sách mảng: contains trúng phần tử", "rule": { "field": "x", "op": "contains", "value": "45" }, "vars": { "x": ["123", "45"] }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách mảng số: contains chuỗi số", "rule": { "field": "x", "op": "contains", "value": "2" }, "vars": { "x": [1, 2] }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách vắng: contains không trúng", "rule": { "field": "x", "op": "contains", "value": "a" }, "vars": {}, "lists": ["x"], "expect": false },
    { "name": "ô chữ: contains chuỗi con", "rule": { "field": "t", "op": "contains", "value": "c12" }, "vars": { "t": "abc123" }, "lists": [], "expect": true },
    { "name": "ô chữ: contains không phân biệt hoa thường", "rule": { "field": "t", "op": "contains", "value": "bc" }, "vars": { "t": "ABC" }, "lists": [], "expect": true },
    { "name": "ô chữ: contains chuỗi rỗng không trúng", "rule": { "field": "t", "op": "contains", "value": "" }, "vars": { "t": "abc" }, "lists": [], "expect": false },
    { "name": "= mảng một phần tử với giá trị đơn", "rule": { "field": "x", "op": "=", "value": "A" }, "vars": { "x": ["A"] }, "lists": [], "expect": true },
    { "name": "= mảng hai phần tử với giá trị đơn", "rule": { "field": "x", "op": "=", "value": "A" }, "vars": { "x": ["A", "B"] }, "lists": [], "expect": false },
    { "name": "= hai mảng cùng thứ tự", "rule": { "field": "x", "op": "=", "value": ["A", "B"] }, "vars": { "x": ["A", "B"] }, "lists": [], "expect": true },
    { "name": "= hai mảng khác thứ tự", "rule": { "field": "x", "op": "=", "value": ["A", "B"] }, "vars": { "x": ["B", "A"] }, "lists": [], "expect": false },
    { "name": "= mảng rỗng với chuỗi rỗng", "rule": { "field": "x", "op": "=", "value": "" }, "vars": { "x": [] }, "lists": [], "expect": true },
    { "name": "= giá trị đơn với mảng một phần tử (vế phải là mảng)", "rule": { "field": "x", "op": "=", "value": ["A"] }, "vars": { "x": "A" }, "lists": [], "expect": true },
    { "name": "!= mảng một phần tử với chính giá trị đó", "rule": { "field": "x", "op": "!=", "value": "A" }, "vars": { "x": ["A"] }, "lists": [], "expect": false },
    { "name": "!= mảng hai phần tử với giá trị đơn", "rule": { "field": "x", "op": "!=", "value": "A" }, "vars": { "x": ["A", "B"] }, "lists": [], "expect": true },
    { "name": "ô danh sách giữ giá trị cũ: = giá trị đó", "rule": { "field": "x", "op": "=", "value": "A" }, "vars": { "x": "A" }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách giữ giá trị cũ: in", "rule": { "field": "x", "op": "in", "value": ["A", "C"] }, "vars": { "x": "A" }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách mảng: not_in", "rule": { "field": "x", "op": "not_in", "value": ["A"] }, "vars": { "x": ["B"] }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách mảng: in trúng một phần tử", "rule": { "field": "x", "op": "in", "value": ["C", "B"] }, "vars": { "x": ["A", "B"] }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách chuỗi rỗng: is_empty", "rule": { "field": "x", "op": "is_empty" }, "vars": { "x": "" }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách mảng rỗng: is_empty", "rule": { "field": "x", "op": "is_empty" }, "vars": { "x": [] }, "lists": ["x"], "expect": true },
    { "name": "ô danh sách có phần tử: not_empty", "rule": { "field": "x", "op": "not_empty" }, "vars": { "x": ["a"] }, "lists": ["x"], "expect": true },
    { "name": "= chuỗi số với số", "rule": { "field": "n", "op": "=", "value": 1 }, "vars": { "n": "1" }, "lists": [], "expect": true },
    { "name": "nhóm all: ô danh sách và ô chữ", "rule": { "all": [{ "field": "x", "op": "contains", "value": "B" }, { "field": "t", "op": "=", "value": "ok" }] }, "vars": { "x": "AB", "t": "ok" }, "lists": ["x"], "expect": false },
    { "name": "ô danh sách mảng: contains so số với chuỗi số có số 0 đầu", "rule": { "field": "x", "op": "contains", "value": 1}, "vars": { "x": ["01"]}, "lists": ["x"], "expect": true},
    { "name": "ô danh sách giữ giá trị cũ đúng/sai: phần tử đúng/sai so theo quy đổi đúng/sai ('x' = sai)", "rule": { "field": "x", "op": "contains", "value": "x" }, "vars": { "x": false}, "lists": ["x"], "expect": true},
    { "name": "in với giá trị so không phải danh sách: không trúng", "rule": { "field": "x", "op": "in", "value": "A" }, "vars": { "x": "A" }, "lists": [], "expect": false},
    { "name": "not_in với giá trị so không phải danh sách: không trúng", "rule": { "field": "x", "op": "not_in", "value": "A" }, "vars": { "x": "B" }, "lists": [], "expect": false},
    { "name": "in so số với chuỗi số", "rule": { "field": "n", "op": "in", "value": ["1.0", "3"]}, "vars": { "n": 1}, "lists": [], "expect": true},
    { "name": "= ô đúng/sai với chuỗi 'true'", "rule": { "field": "b", "op": "=", "value": "true" }, "vars": { "b": true}, "lists": [], "expect": true},
    { "name": "= ô đúng/sai false với chuỗi rỗng", "rule": { "field": "b", "op": "=", "value": "" }, "vars": { "b": false}, "lists": [], "expect": true},
    { "name": "= chuỗi hệ 16 không phải số", "rule": { "field": "n", "op": "=", "value": 16 }, "vars": { "n": "0x10" }, "lists": [], "expect": false },
    { "name": "= chuỗi số thập phân với số nguyên", "rule": { "field": "n", "op": "=", "value": 1}, "vars": { "n": "1.0" }, "lists": [], "expect": true}
  ]
}
